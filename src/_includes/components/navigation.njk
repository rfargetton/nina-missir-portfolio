<nav id="nav-menu" class="hidden md:flex flex-col md:flex-row md:items-center gap-4 md:gap-8 absolute md:static top-full left-0 right-0 bg-cream md:bg-transparent border-b md:border-0 border-sand p-4 md:p-0">
  {% for item in navigation.items | sort(attribute="order") %}
    {% if item.type == "home" %}
      {% set href = "/" %}
    {% elif item.type == "page" %}
      {% set href = item.reference %}
    {% else %}
      {% set href = "/services/" + item.reference + "/" %}
    {% endif %}
    {% if href == "/contact/" %}
      <a href="{{ href }}" class="bg-primary text-white px-5 py-2 rounded-lg hover:bg-primary/90 transition-colors text-center">{{ item.title }}</a>
    {% else %}
      <a href="{{ href }}" class="text-bark/80 hover:text-primary transition-colors">{{ item.title }}</a>
    {% endif %}
  {% endfor %}
</nav>
