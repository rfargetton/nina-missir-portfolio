---
layout: base.njk
---

<header class="bg-gradient-to-r from-bark to-primary text-white py-16">
  <div class="container mx-auto px-4">
    <h1 class="text-4xl md:text-5xl font-serif font-bold mb-4">{{ title }}</h1>
    <p class="text-xl text-sand max-w-2xl">{{ description }}</p>
  </div>
</header>

<section class="py-20">
  <div class="container mx-auto px-4">
    <div class="prose prose-lg max-w-4xl mx-auto mb-16">
      {{ content | safe }}
    </div>
  </div>
</section>

<section class="py-20 bg-white">
  <div class="container mx-auto px-4">
    <h2 class="text-3xl font-serif font-bold mb-12 text-center">Demander un devis</h2>
    {% include "components/form-devis.njk" %}
  </div>
</section>

<section class="py-20">
  <div class="container mx-auto px-4">
    <h2 class="text-3xl font-serif font-bold mb-12 text-center">Contact général</h2>
    <form name="contact" method="POST" netlify netlify-honeypot="bot-field-contact" class="max-w-2xl mx-auto bg-white p-8 rounded-lg shadow-md border border-sand">
      <p hidden><input name="bot-field-contact"></p>
      <div class="mb-6">
        <label class="block text-sm font-medium mb-2">Nom *</label>
        <input type="text" name="nom" required class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-primary">
      </div>
      <div class="mb-6">
        <label class="block text-sm font-medium mb-2">Email *</label>
        <input type="email" name="email" required class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-primary">
      </div>
      <div class="mb-6">
        <label class="block text-sm font-medium mb-2">Message *</label>
        <textarea name="message" rows="5" required class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-primary"></textarea>
      </div>
      <button type="submit" class="w-full btn-primary">Envoyer</button>
    </form>
  </div>
</section>

<section class="py-20 bg-cream">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-4xl mx-auto text-center">
      <div>
        <h3 class="font-semibold text-lg mb-2">Email</h3>
        <a href="mailto:{{ site.email }}" class="text-primary hover:underline">{{ site.email }}</a>
      </div>
      <div>
        <h3 class="font-semibold text-lg mb-2">Téléphone</h3>
        <a href="tel:{{ site.phone | replace(' ', '') }}" class="text-primary hover:underline">{{ site.phone }}</a>
      </div>
      <div>
        <h3 class="font-semibold text-lg mb-2">Adresse</h3>
        <p>{{ site.address }}</p>
      </div>
    </div>
  </div>
</section>
