---
layout: base.njk
---

<section class="relative bg-gradient-to-br from-bark via-primary to-moss text-white py-24 md:py-32">
  <div class="container mx-auto px-4">
    <p class="text-sand uppercase tracking-widest text-sm mb-4">{{ eyebrow or "Peintre muraliste & illustratrice — Nantes" }}</p>
    <h1 class="text-5xl md:text-6xl font-serif font-bold mb-6">{{ title }}</h1>
    <p class="text-xl md:text-2xl text-sand mb-8 max-w-2xl">{{ description }}</p>
    <div class="flex flex-wrap gap-4">
      <a href="/tous-les-projets/" class="btn-primary bg-secondary hover:bg-secondary/90">{{ hero_cta1_label or "Voir les réalisations" }}</a>
      <a href="/contact/" class="inline-block px-8 py-3 border-2 border-white text-white rounded-lg font-semibold hover:bg-white/10 transition-colors">{{ hero_cta2_label or "Parler d'un projet" }}</a>
    </div>
  </div>
</section>

<section id="services" class="py-20">
  <div class="container mx-auto px-4">
    <h2 class="text-4xl font-serif font-bold text-center mb-4">{{ services_title or "Nos services" }}</h2>
    <p class="text-center text-bark/70 mb-16 max-w-2xl mx-auto">{{ services_subtitle or "Fresques, vitrines et illustration pour commerces, collectivités, écoles et entreprises." }}</p>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {% for service in collections.services %}
        {% include "components/service-card.njk" %}
      {% endfor %}
    </div>
  </div>
</section>

<section class="py-20 bg-white">
  <div class="container mx-auto px-4">
    <h2 class="text-4xl font-serif font-bold text-center mb-4">{{ projects_title or "Derniers projets" }}</h2>
    <p class="text-center text-bark/70 mb-16">{{ projects_subtitle or "Découvrez nos réalisations récentes à Nantes et en Pays de la Loire" }}</p>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
      {% for project in collections.latestProjects %}
        {% include "components/project-card.njk" %}
      {% endfor %}
    </div>
    <div class="text-center">
      <a href="/tous-les-projets/" class="btn-primary">{{ projects_cta_label or "Voir tous les projets" }}</a>
    </div>
  </div>
</section>

{% if collections.testimonials.length > 0 %}
<section class="py-20">
  <div class="container mx-auto px-4">
    <h2 class="text-4xl font-serif font-bold text-center mb-12">{{ testimonials_title or "Ils nous font confiance" }}</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
      {% for item in collections.testimonials %}
        <blockquote class="bg-white p-8 rounded-lg shadow-sm border border-sand">
          <p class="text-lg italic text-bark/80 mb-4">« {{ item.data.quote }} »</p>
          <footer class="text-sm font-semibold">
            {{ item.data.name }}{% if item.data.company %}, {{ item.data.company }}{% endif %}
          </footer>
        </blockquote>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% include "components/cta-contact.njk" %}

{{ content | safe }}
