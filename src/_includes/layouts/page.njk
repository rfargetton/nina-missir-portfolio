---
layout: base.njk
---

<header class="bg-gradient-to-r from-bark to-primary text-white py-16">
  <div class="container mx-auto px-4">
    <h1 class="text-4xl md:text-5xl font-serif font-bold mb-4">{{ title }}</h1>
    {% if description %}
      <p class="text-xl text-sand max-w-2xl">{{ description }}</p>
    {% endif %}
  </div>
</header>

<section class="py-20">
  <div class="container mx-auto px-4">
    <div class="prose prose-lg max-w-4xl mx-auto">
      {{ content | safe }}
    </div>
  </div>
</section>

{% include "components/cta-contact.njk" %}
